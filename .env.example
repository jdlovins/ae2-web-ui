# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# --- required ---------------------------------------------------------------
# The mod's HTTP API base URL. Must be reachable FROM INSIDE the containers,
# so use the LAN IP, not 127.0.0.1. No trailing slash or path.
AE2_URL=http://10.10.10.100:65500
# The mod's admin password (the one you type on the terminal's login screen).
AE2_PASSWORD=

# --- optional --------------------------------------------------------------
AE2_USERNAME=Admin

# Seconds between inventory snapshots. /items runs on the Minecraft server
# tick, so below ~15s will visibly lag the game.
SAMPLE_INTERVAL_SEC=60
# Comma-separated grid keys to track. Empty = discover and track all of them.
SAMPLE_GRIDS=
# e.g. "365 days" to drop older samples. Empty = keep history forever.
SAMPLE_RETENTION=

# Host ports
WEBUI_HOST_PORT=8080
GATEWAY_HOST_PORT=8081
POSTGRES_HOST_PORT=5433

# Database (defaults are fine for a self-contained stack)
POSTGRES_DB=ae2
POSTGRES_USER=ae2
POSTGRES_PASSWORD=ae2
